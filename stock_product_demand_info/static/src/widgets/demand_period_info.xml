<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="stock_product_demand_info.DemandPeriodInfoGrid">
        <div t-if="this.rows.length" class="o_demand_period_info_grid">
            <table class="table table-borderless table-sm mb-0">
                <tbody>
                    <t t-foreach="this.rows" t-as="row" t-key="row[0]">
                        <tr>
                            <td t-out="row[1].name" />
                            <td class="text-end">
                                <t t-out="row[1].formatted_value" />
                                <span class="ms-1" t-out="this.uomName" />
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </div>
        <div t-else="" class="text-muted fst-italic">—</div>
    </t>

    <t t-name="stock_product_demand_info.DemandPeriodInfoPopoverContent">
        <div class="p-2">
            <h6>Demand by period</h6>
            <t t-call="stock_product_demand_info.DemandPeriodInfoGrid" />
        </div>
    </t>

    <t t-name="stock_product_demand_info.DemandPeriodInfoPopoverButton">
        <a
            t-if="this.rows.length"
            class="fa fa-bar-chart cursor-pointer"
            role="button"
            t-att-tabindex="0"
            t-on-click="(ev) => this.showPopover(ev)"
            title="Demand by period"
        />
    </t>

</templates>
